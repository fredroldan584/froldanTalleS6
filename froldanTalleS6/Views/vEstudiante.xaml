<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="froldanTalleS6.Views.vEstudiante"
             Title="vEstudiante">
    <VerticalStackLayout>
        <Label
            Text="Semana 6: Servicios web - Estudiante"
            VerticalOptions="Center"
            FontSize="20"
            HorizontalOptions="Center"/>
        <ListView x:Name="listaEstudiante" ItemSelected="listaEstudiante_ItemSelected">
            
            <!-- Encabezado -->

            <ListView.Header>
                <Grid ColumnDefinitions="80,150,150,80" Padding="10" BackgroundColor="#2F4BA0">
                    <Label Grid.Column="0" Text="Código"   FontAttributes="Bold" TextColor="White"/>
                    <Label Grid.Column="1" Text="Nombre"   FontAttributes="Bold" TextColor="White"/>
                    <Label Grid.Column="2" Text="Apellido" FontAttributes="Bold" TextColor="White"/>
                    <Label Grid.Column="3" Text="Edad"     FontAttributes="Bold" TextColor="White"/>
                </Grid>
            </ListView.Header>
            
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid ColumnDefinitions="80,150,150,80" Padding="10">
                            <Label Grid.Column="0" Text="{Binding codigo}"/>
                            <Label Grid.Column="1" Text="{Binding nombre}"/>
                            <Label Grid.Column="2" Text="{Binding apellido}"/>
                            <Label Grid.Column="3" Text="{Binding edad}"/>
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button x:Name="btnAgregar" Text="Agregar Estudiante" Margin="10"
                Clicked="btnAgregar_Clicked" />
    </VerticalStackLayout>
</ContentPage>