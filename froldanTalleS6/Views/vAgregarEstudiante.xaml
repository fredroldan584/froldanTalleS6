<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="froldanTalleS6.Views.vAgregarEstudiante"
             Title="vAgregarEstudiante">
    <VerticalStackLayout Padding="20" Spacing="10">
        <Label Text="Agregar Estudiante" FontSize="20" HorizontalOptions="Center" />
        <Entry x:Name="txtNombre" Placeholder="Nombre" />
        <Entry x:Name="txtApellido" Placeholder="Apellido" />
        <Entry x:Name="txtEdad" Placeholder="Edad" Keyboard="Numeric" />
        <Button x:Name="btnAgregar" Text="Guardar" Clicked="btnAgregar_Clicked" />
        <Button x:Name="btnCancelar" Text="Cancelar" Clicked="btnCancelar_Clicked" />
    </VerticalStackLayout>
</ContentPage>